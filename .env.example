# Settings for docker-compose.yml (Elasticsearch, Kibana, Metricbeat).
# Copy to .env and adjust: cp .env.example .env
# Every variable is required; docker compose fails if one is unset.
# `make system-test` also loads .env, so the system tests use the same ports.

# Host address Elasticsearch and Kibana are published on: 127.0.0.1 (this machine
# only) or 0.0.0.0 (every interface, reachable from the LAN).
STACK_BIND_IP=127.0.0.1
# Host port Elasticsearch is published on (container port 9200).
ES_PORT=9200
# Host port Kibana is published on (container port 5601).
KIBANA_PORT=5601

# Elasticsearch JVM heap, used for both -Xms and -Xmx (e.g. 512m, 1g, 2g).
ES_HEAP=1g
# Log level for the org.elasticsearch logger (error, warn, info, debug, trace).
ES_LOG_LEVEL=error

# Elasticsearch user Kibana connects as. Must exist in
# testing/docker/elasticsearch/users (file realm).
KIBANA_ES_USER=kibana_system_user
KIBANA_ES_PASS=changeme

# Elasticsearch user Metricbeat (profile "monitoring") connects as. Must exist in
# testing/docker/elasticsearch/users (file realm).
METRICBEAT_ES_USER=admin
METRICBEAT_ES_PASS=changeme
